{
  "name": "myanso",
  "productName": "Myanso",
  "version": "0.4.1",
  "description": "Myanso — a Myanmar-aware terminal.",
  "main": "main.js",
  "author": "saturngod",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "rebuild": "electron-rebuild -f -w node-pty",
    "patch-xterm": "node patches/patch-xterm-myanmar.js",
    "postinstall": "electron-rebuild -f -w node-pty && node patches/patch-xterm-myanmar.js",
    "dist": "node patches/patch-xterm-myanmar.js && electron-builder --config electron-builder.yml",
    "test": "node --test test/*.test.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check patches/patch-xterm-myanmar.js && npm test && npm run patch-xterm",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "42.3.3",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.1.0"
  }
}
